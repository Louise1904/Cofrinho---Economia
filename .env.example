# Copie este arquivo para .env e preencha com seus dados

# String de conexão do Neon (Dashboard do Neon > Connect > Connection string)
DATABASE_URL=postgresql://usuario:senha@ep-xxxxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Chave secreta para os tokens de login (use um texto longo e aleatório)
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

PORT=3000
